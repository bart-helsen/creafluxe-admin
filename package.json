    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "import-products": "tsx scripts/import-products.ts",
    "import-materials": "tsx scripts/import-materials.ts",
    "sync-material-costs": "tsx scripts/sync-material-costs.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "imapflow": "^2.12.1",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "pdfkit": "^0.15.2",
    "postal-mime": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.37.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "msgpackr-extract@3.0.7": true,
    "workerd@1.20260704.1": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
