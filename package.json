{
  "name": "creafluxe-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Creafluxe administration software — order intake, tracking, invoicing (Phase 0 skeleton).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
