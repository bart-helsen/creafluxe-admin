# -----------------------------------------------------------------------------
# Creafluxe Admin — environment variables
# Copy this file to `.env` (which is git-ignored) and fill in the values.
# On Railway, set the same variables in the service's "Variables" tab.
# -----------------------------------------------------------------------------

# --- Phase 0 (required) ------------------------------------------------------

# PostgreSQL connection string from Railway (Postgres service → "Connect").
# Use the PUBLIC url for local development; use the PRIVATE/internal url for the
# app running on Railway (same project, private network).
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Auth.js session-signing secret. Generate one with:  npx auth secret
# (or: openssl rand -base64 33). Must be set the same everywhere the app runs.
AUTH_SECRET="replace-with-a-long-random-string"

# Auth.js must trust the host header behind Railway's proxy.
AUTH_TRUST_HOST="true"

# --- Phase 1: order intake ---------------------------------------------------

# Shared secret the website sends as `X-Api-Key` on POST /api/orders/intake and
# /api/uploads/presign. Store the same value in the website's config.
# Generate: node -e "console.log(require('crypto').randomBytes(33).toString('base64url'))"
INTAKE_API_KEY="another-long-random-string"

# Public base URL of this admin app — used to build deep links in the new-order
# notification email.
APP_URL="https://admin.creafluxe.be"

# --- Phase 1: file storage (Cloudflare R2) -----------------------------------
# Optional locally: without these, uploads/presign returns 501 and invoice PDFs
# are rendered on demand instead of stored. Required in production for design
# files. Create an R2 bucket + API token in the Cloudflare dashboard.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="creafluxe-designs"

# --- Phase 1: transactional email (Resend) -----------------------------------
# Optional locally: without RESEND_API_KEY the new-order email is logged (not
# sent) and still recorded in NotificationLog. Required in production.
# RESEND_API_KEY=""
# EMAIL_FROM="Creafluxe Admin <admin@creafluxe.be>"   # must be a verified sender
# NOTIFY_EMAIL="orders@creafluxe.be"                  # inbox that gets alerts

# --- Phase 1: your company details (printed on invoice PDFs) ------------------
# Legally required on an invoice: your name, address, VAT number, dates.
# Fill these with your real, accountant-approved values.
# COMPANY_NAME="Creafluxe"
# COMPANY_VAT="BE0123456789"
# COMPANY_EMAIL="info@creafluxe.be"
# COMPANY_PHONE=""
# COMPANY_WEBSITE="creafluxe.be"
# COMPANY_IBAN="BE00 0000 0000 0000"
# COMPANY_ADDRESS_STREET=""
# COMPANY_ADDRESS_POSTAL=""
# COMPANY_ADDRESS_CITY=""
# COMPANY_ADDRESS_COUNTRY="België"
# COMPANY_PAYMENT_TERM_DAYS="14"

# --- Phase 2b: inventory (materials, suppliers, costing) ---------------------
# Pricing helper defaults used by the BOM costing + custom-quote calculator.
# markup is applied to material cost; hourly rate is added to custom quotes.
# PRICING_MARKUP_PERCENT="60"   # e.g. 60 → suggested price = cost × 1.60
# PRICING_HOURLY_RATE="45"      # your labour rate per hour (EUR, excl. VAT)

# Secret that authorises the daily low-stock cron (GET/POST /api/cron/low-stock).
# If unset, the endpoint falls back to INTAKE_API_KEY. On Railway, add a
# scheduled job that calls the URL with header `X-Api-Key: <this secret>`.
# CRON_SECRET=""

# --- Later phases ------------------------------------------------------------
# MOLLIE_API_KEY=""          # Phase 3 — payments
# PEPPOL_ACCESS_POINT_KEY="" # Phase 4 — e-invoicing
